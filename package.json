{
  "name": "multi-madrasa-platform",
  "version": "1.0.0",
  "description": "Multi-Madrasa Management SaaS Platform - multi-tenant school management for Madaris in Ijebu-Ode, Ogun State, Nigeria. Arabic + English, RTL, mobile-first.",
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning server/index.js",
    "migrate": "node --disable-warning=ExperimentalWarning server/migrate.js",
    "backup": "node --disable-warning=ExperimentalWarning server/backup.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "reset-admin-password": "node --disable-warning=ExperimentalWarning server/reset-admin-password.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "loadtest:seed": "node --disable-warning=ExperimentalWarning loadtest/seed.js",
    "loadtest:smoke": "node --disable-warning=ExperimentalWarning loadtest/run.js --stage 20 --steps 20 --hold 15 --url http://127.0.0.1:3100 --manage-server --isolation",
    "loadtest:stage": "node --disable-warning=ExperimentalWarning loadtest/run.js --url http://127.0.0.1:3100 --manage-server --isolation"
  },
  "engines": {
    "node": ">=22.22.3 <23.0.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "js-yaml": "^5.4.1",
    "jsdom": "^30.0.1"
  }
}
