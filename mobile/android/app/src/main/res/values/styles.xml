<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#220b40</item>
        <item name="colorPrimaryDark">#180829</item>
        <item name="colorAccent">#f4c542</item>
        <item name="android:windowBackground">#220b40</item>
        <item name="android:statusBarColor">#220b40</item>
        <item name="android:navigationBarColor">#220b40</item>
        <!-- Edge-to-edge: the CSS safe-area insets handle the notch. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
