<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    EduSphere desktop — hardened-runtime entitlements (used only when the macOS
    build is actually signed; an unsigned local build ignores this file).

      allow-jit / allow-unsigned-executable-memory
          V8 (Chromium) needs a writable+executable region for its JIT. Without
          these two keys every signed Electron build crashes at launch.
      disable-library-validation
          Electron loads its own Framework and helper dylibs that are not
          signed by the app's team id.
      network.client
          The app talks to the school's EduSphere server over HTTPS.
      network.server
          SCHOOL LAN HUB MODE: the embedded Express server listens on the local
          network so phones and tablets can connect. Removing this entitlement
          would silently break LAN mode on a signed macOS build.
      print
          Native printing of report cards, receipts and ID cards.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <key>com.apple.security.print</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
